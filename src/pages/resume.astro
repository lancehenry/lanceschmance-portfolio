---
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { resume } from '@/config/resume';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileSchema } from '@/lib/schema';

type Job = (typeof resume.experience)[number];

// Consecutive roles at the same company become one group, newest first, so promotions read as a career track.
const companies = resume.experience.reduce<{ company: string; roles: Job[] }[]>((groups, job) => {
  const last = groups.at(-1);
  if (last && last.company === job.company) last.roles.push(job);
  else groups.push({ company: job.company, roles: [job] });
  return groups;
}, []);

const startOf = (period: string) => period.split('-')[0].trim();
const endOf = (period: string) => period.split('-').at(-1)?.trim() ?? '';
const tenure = (roles: Job[]) => {
  const start = Number(startOf(roles.at(-1)?.period ?? ''));
  const endText = endOf(roles[0]?.period ?? '');
  const end = /present/i.test(endText) ? new Date().getFullYear() : Number(endText);
  const years = end - start;
  return Number.isFinite(years) && years > 0 ? `${years} ${years === 1 ? 'year' : 'years'}` : '';
};
---

<BaseLayout
  title="Resume"
  description={`Resume of ${siteConfig.author.name}: 15+ years of creative direction, brand, web, motion, and campaign work.`}
  type="profile"
  structuredData={profileSchema('/resume/')}
>
  <PageHero eyebrow={resume.eyebrow} title={resume.title} highlight={resume.highlight} text={resume.text}>
    <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
      {siteConfig.resumePdf && (
        <a class="btn btn-primary" href={siteConfig.resumePdf} download>
          <Icon name="download" class="size-4" />
          Download PDF
        </a>
      )}
      <a
        class:list={['btn', siteConfig.resumePdf ? 'btn-ghost' : 'btn-primary']}
        href={`mailto:${siteConfig.author.email}`}
      >
        <Icon name="mail" class="size-4" />
        Email me
      </a>
    </div>
  </PageHero>

  <div class="shell mt-20 sm:mt-28">
    <section class="resume-row reveal" aria-labelledby="snapshot-title">
      <h2 id="snapshot-title" class="eyebrow self-start">
        Snapshot
      </h2>
      <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {resume.snapshot.map((item) => (
          <div>
            <dt class="text-sm text-muted">{item.label}</dt>
            <dd class="mt-1 text-lg font-medium">{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="resume-row reveal" aria-labelledby="experience-title">
      <h2 id="experience-title" class="eyebrow self-start">
        Experience
      </h2>
      <ol class="grid gap-14">
        {companies.map(({ company, roles }) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
              <h3 class="text-title">{company}</h3>
              <p class="text-sm text-muted">
                {startOf(roles.at(-1)?.period ?? '')} - {endOf(roles[0]?.period ?? '')}
                {tenure(roles) && <span> · {tenure(roles)}</span>}
              </p>
            </div>
            <ol class="career-track mt-6">
              {roles.map((job, index) => (
                <li class="career-role">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
                    <h4 class="text-lg font-semibold">{job.role}</h4>
                    <p class="text-sm text-muted">{job.period}</p>
                  </div>
                  <p class="mt-2 max-w-2xl text-body">{job.text}</p>
                  {index < roles.length - 1 && (
                    <p class="promotion">
                      <span class="promotion-pill">
                        <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                          <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        Promoted {startOf(job.period)}
                      </span>
                      <span class="sr-only">from {roles[index + 1]?.role} to {job.role}</span>
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </section>

    <section class="resume-row reveal" aria-labelledby="capabilities-title">
      <h2 id="capabilities-title" class="eyebrow self-start">
        Capabilities
      </h2>
      <ul class="grid gap-8 sm:grid-cols-3">
        {resume.capabilities.map((item) => (
          <li>
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="resume-row reveal" aria-labelledby="education-title">
      <h2 id="education-title" class="eyebrow self-start">
        Education
      </h2>
      <ul class="grid gap-6">
        {resume.education.map((item) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
            <span>
              <span class="font-semibold">{item.title}</span>
              <span class="text-muted">, {item.place}</span>
            </span>
            <span class="text-sm text-muted">{item.period}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="resume-row reveal" aria-labelledby="tools-title">
      <h2 id="tools-title" class="eyebrow self-start">
        Tools
      </h2>
      <ul class="flex flex-wrap gap-2">
        {resume.tools.map((tool) => (
          <li class="chip min-h-10 px-4 text-[0.95rem]">{tool}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .resume-row {
    display: grid;
    gap: 1.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .resume-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 4rem;
    }
  }

  /* A rail down the left of each company's roles, with a dot per role. */
  .career-track {
    position: relative;
    display: grid;
    gap: 2.75rem;
  }

  .career-role {
    position: relative;
    padding-left: 2rem;
  }

  .career-role::before {
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--canvas);
    content: '';
  }

  /* The current or newest role gets a filled dot. */
  .career-role:first-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* The rail connects a role's dot to the next one down. */
  .career-role:not(:last-child)::after {
    position: absolute;
    top: 1.55rem;
    bottom: -3.3rem;
    left: calc(0.375rem - 1px);
    width: 2px;
    background: var(--line-strong);
    content: '';
  }

  /* "Promoted" sits on the rail between two roles. */
  .promotion {
    position: absolute;
    z-index: 1;
    bottom: -2.05rem;
    left: 0.375rem;
    /* Center the arrow on the rail. */
    translate: -0.94rem 0;
  }

  .promotion-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.7rem 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
