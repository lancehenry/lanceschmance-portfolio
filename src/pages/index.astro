---
import Hero from '@/components/home/Hero.astro';
import Reel from '@/components/home/Reel.astro';
import Services from '@/components/home/Services.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';
import { focusPages } from '@/config/focus';
import { work } from '@/config/home';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/work';

const projects = await getProjects();
const selected = projects.toSorted((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, work.limit);
---

<BaseLayout>
  <Hero />
  <Reel />

  <section id="work" class="shell mt-20 sm:mt-28" aria-labelledby="work-title">
    <SectionHead id="work-title" eyebrow={work.eyebrow} title={work.title} text={work.text}>
      <a class="btn btn-ghost" href="/work/">
        All work
        <Icon name="arrow-right" class="icon-nudge size-4" />
      </a>
    </SectionHead>
    <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-2">
      {selected.map((project, index) => (
        <ProjectCard project={project} eager={index < 2} />
      ))}
    </div>
  </section>

  <Services />

  <section class="shell mt-24 sm:mt-32" aria-labelledby="focus-title">
    <div class="reveal flex flex-wrap items-baseline justify-between gap-6 border-t border-line pt-8">
      <h2 id="focus-title" class="eyebrow">
        Browse by focus
      </h2>
      <ul class="flex flex-wrap gap-2">
        {focusPages.map((page) => (
          <li>
            <a class="filter-chip" href={`/${page.slug}/`}>
              {page.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
