---
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
---

<!-- "LS" monogram. Replace these paths with your own mark. -->
<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="var(--inverse)"></rect>
  <path d="M8 9.5v13h6" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
  ></path>
  <path
    d="M24 11.2c-.9-1.1-2.2-1.7-3.6-1.7-2 0-3.4 1.1-3.4 2.8 0 3.9 7.2 2.4 7.2 6.4 0 1.8-1.5 3.1-3.7 3.1-1.6 0-3-.7-3.9-1.9"
    stroke="var(--on-inverse)"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
