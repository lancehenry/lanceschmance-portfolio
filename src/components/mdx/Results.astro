---
/**
 * The results panel: up to three numbers and an optional quote or summary line.
 * <Results items={[{ value: '38%', label: 'more sign-ups' }, ...]}>Optional closing line.</Results>
 */
interface Props {
  title?: string;
  items: { value: string; label: string }[];
}

const { title = 'Results', items } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<section class="not-prose rounded-card bg-night p-8 text-night-ink sm:p-12" aria-label={title}>
  <p class="eyebrow text-night-muted">{title}</p>
  <dl class="mt-8 grid gap-8 sm:grid-cols-3">
    {items.map((item) => (
      <div class="flex flex-col-reverse gap-2">
        <dt class="text-night-muted">{item.label}</dt>
        <dd class="text-[clamp(2.4rem,1.8rem+2vw,3.5rem)] leading-none font-medium tracking-[-0.03em] text-accent">{item.value}</dd>
      </div>
    ))}
  </dl>
  {hasSlot && (
    <div class="mt-10 max-w-[44rem] text-lead text-night-ink/85">
      <slot />
    </div>
  )}
</section>
