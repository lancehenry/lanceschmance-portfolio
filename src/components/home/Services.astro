---
import SectionHead from '@/components/ui/SectionHead.astro';
import { capabilities } from '@/config/home';
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="capabilities-title">
  <SectionHead id="capabilities-title" eyebrow={capabilities.eyebrow} title={capabilities.title} />
  <ol class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    {capabilities.items.map((item, index) => (
      <li class="reveal flex flex-col bg-surface p-7 sm:p-8">
        <span class="text-sm font-bold tracking-[0.08em] text-accent-ink" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-8 text-title">{item.title}</h3>
        <p class="mt-3 text-muted">{item.text}</p>
      </li>
    ))}
  </ol>
</section>
