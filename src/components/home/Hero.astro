---
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  {siteConfig.availability.enabled && (
    <p class="rise inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pr-4 pl-3 text-sm text-body">
      <span class="availability-dot" aria-hidden="true" />
      {siteConfig.availability.label}
    </p>
  )}

  <h1 id="hero-title" class="rise mt-8 max-w-[18ch] text-display font-normal tracking-[-0.035em]" style="--rise-step: 1">
    <span class="sr-only">{hero.spoken}</span>
    <span aria-hidden="true">
      {hero.greeting} {hero.title}{' '}
      <span class="rotator" style={`--count: ${hero.rotating.length}`}>
        {hero.rotating.map((word, index) => (
          <span class="rotator-word" style={`--i: ${index}`}>
            {word}
          </span>
        ))}
      </span>
    </span>
  </h1>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="rise" style="--rise-step: 2">
      <p class="max-w-xl text-lead text-body">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
    </div>

    <dl
      class="rise grid grid-cols-3 gap-6 border-t border-line pt-6 sm:gap-10 lg:border-t-0 lg:pt-0"
      style="--rise-step: 3"
    >
      {hero.facts.map((fact) => (
        <div class="flex flex-col-reverse gap-1">
          <dt class="max-w-[13ch] text-sm leading-snug text-muted">{fact.label}</dt>
          <dd class="text-section font-semibold">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Every word sits in the same grid cell, so the line never reflows as they swap. */
  .rotator {
    display: inline-grid;
    /* Sit on the same baseline as the rest of the headline. */
    vertical-align: baseline;
    color: var(--accent-ink);
    font-weight: 500;
  }

  .rotator-word {
    grid-area: 1 / 1;
  }

  .rotator-word:not(:first-child) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Clip words as they slide, without overflow or padding, which would shift the baseline.
       The negative insets leave room for ascenders and descenders. */
    .rotator {
      clip-path: inset(-0.15em -0.5em -0.3em -0.5em);
    }

    .rotator-word,
    .rotator-word:not(:first-child) {
      visibility: visible;
      opacity: 0;
      animation: rotate-word calc(var(--count) * 2.6s) var(--ease-out-expo) infinite;
      animation-delay: calc(var(--i) * 2.6s);
    }

    /* The first word is already in place when the page loads. */
    .rotator-word:first-child {
      animation-name: rotate-word-first;
    }
  }

  @keyframes rotate-word {
    0% {
      opacity: 0;
      transform: translateY(0.55em);
    }
    4%,
    17% {
      opacity: 1;
      transform: none;
    }
    20%,
    100% {
      opacity: 0;
      transform: translateY(-0.55em);
    }
  }

  @keyframes rotate-word-first {
    0%,
    17% {
      opacity: 1;
      transform: none;
    }
    20%,
    96% {
      opacity: 0;
      transform: translateY(-0.55em);
    }
    96.01% {
      transform: translateY(0.55em);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .availability-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22a55b;
  }
</style>
